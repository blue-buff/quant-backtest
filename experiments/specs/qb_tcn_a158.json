{
  "exp_id": "qb_tcn_a158",
  "base": "ref:qb_off",
  "overrides": {
    "dataset": {
      "handler": {
        "class": "Alpha158"
      }
    },
    "processors": {
      "learn": [
        {
          "class": "DropnaLabel"
        },
        {
          "class": "CSRankNorm",
          "kwargs": {
            "fields_group": "label"
          }
        }
      ],
      "infer": [
        {
          "class": "FilterCol",
          "kwargs": {
            "fields_group": "feature",
            "col_list": [
              "RESI5",
              "WVMA5",
              "RSQR5",
              "KLEN",
              "RSQR10",
              "CORR5",
              "CORD5",
              "CORR10",
              "ROC60",
              "RESI10",
              "VSTD5",
              "RSQR60",
              "CORR60",
              "WVMA60",
              "STD5",
              "RSQR20",
              "CORD60",
              "CORD10",
              "CORR20",
              "KLOW"
            ]
          }
        },
        {
          "class": "RobustZScoreNorm",
          "kwargs": {
            "fields_group": "feature",
            "clip_outlier": true
          }
        },
        {
          "class": "Fillna",
          "kwargs": {
            "fields_group": "feature"
          }
        }
      ]
    },
    "model": {
      "class": "TCN",
      "module_path": "qlib.contrib.model.pytorch_tcn_ts",
      "kwargs": {
        "d_feat": 20,
        "num_layers": 5,
        "n_chans": 32,
        "kernel_size": 7,
        "dropout": 0.5,
        "n_epochs": 200,
        "lr": 0.0001,
        "early_stop": 20,
        "batch_size": 2000,
        "metric": "loss",
        "loss": "mse",
        "optimizer": "adam",
        "n_jobs": 20,
        "GPU": 0
      }
    }
  },
  "params": {
    "step_len": 20,
    "dataset_class": "TSDatasetH",
    "topk": 50,
    "n_drop": 5
  },
  "action": {
    "kind": "train",
    "executor": "executors/qlib_bench",
    "test_start": "2025-01-01",
    "test_end": "2026-08-20"
  },
  "metrics": [
    "rankic",
    "bootstrap",
    "deciles",
    "quarters",
    "hit",
    "portfolio",
    "backtest",
    "attribution"
  ],
  "changes": "官方 qlib benchmark 复现: TCN/Alpha158 官方参数, 只改时间窗 (train 2021-06~2024-06 / valid 2024-07~2024-12 / test 2025-01~2026-08), hs300, 官方 1d label, 统一固定测试器口径",
  "timeout_min": 90,
  "runner": "spark"
}