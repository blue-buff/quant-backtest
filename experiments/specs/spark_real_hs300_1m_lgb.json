{
  "exp_id": "spark_real_hs300_1m_lgb",
  "base": "ref:all10d_ens3",
  "overrides": {
    "universe": "hs300",
    "dataset": {"handler": {"instruments": "csi300"}},
    "label": {"horizon": 1, "formula": "Ref($close,-2)/Ref($close,-1)-1", "shift": -2},
    "seeds": [42]
  },
  "action": {
    "kind": "train",
    "executor": "executors/_example_lgb",
    "test_start": "2025-01-01",
    "test_end": "2025-01-31",
    "rounds": 30,
    "early_stopping": 5,
    "num_threads": 8
  },
  "metrics": ["rankic", "bootstrap"],
  "changes": "Real Spark acceptance: hs300 one-month test, single-seed LightGBM, prediction metrics only",
  "expectation": {"rankic_mean_min": 0.0, "p_le0_max": 0.5},
  "timeout_min": 30,
  "runner": "spark"
}
